{
  "manifest_version": 3,
  "name": "Lector Accesible IA",
  "version": "1.0.1",
  "minimum_chrome_version": "109",
  "description": "Navegación por Tab con voz clonada Don IA (VoiceStudio local)",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "offscreen", "scripting", "activeTab", "tabs"],
  "host_permissions": ["http://127.0.0.1:3902/*", "<all_urls>"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content/navegacion.js"], "run_at": "document_idle" }],
  "offscreen_documents": [{ "url": "offscreen/offscreen.html", "reasons": ["AUDIO_PLAYBACK"] }],
  "action": { "default_title": "Lector Accesible IA — modo navegación", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "commands": { "toggle-nav": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Activar/desactivar modo navegación" } }
}